# Discord — https://discord.com/developers/applications
DISCORD_TOKEN=
DISCORD_CLIENT_ID=
# Register commands to one server (instant). Leave blank to register globally (up to an hour).
DISCORD_GUILD_ID=

# Where people reach the whiteboard. Must be the public HTTPS address of this machine,
# because contributors open it in a browser. No trailing slash.
#
# On Railway you can leave this blank: the app falls back to RAILWAY_PUBLIC_DOMAIN, which
# Railway sets for you. Set it explicitly once you attach a custom domain.
FLIPCHART_PUBLIC_URL=https://flipchart.example.com

# Signs contribution links and derives every pseudonym. Generate with:
#   openssl rand -hex 32
# Keep it secret and keep it stable — changing it invalidates outstanding links and
# reshuffles everyone's anonymous names.
FLIPCHART_SECRET=

# Optional
# Register slash commands on boot. Useful on a platform where running a one-off command is
# awkward — on Railway, set this to true instead of running `npm run deploy`.
# FLIPCHART_SYNC_COMMANDS=false

# PORT (set by most hosts) wins over this.
# FLIPCHART_PORT=3000
# On Railway, RAILWAY_VOLUME_MOUNT_PATH is used automatically when a volume is attached.
# FLIPCHART_DATA_DIR=./data
# FLIPCHART_LINK_TTL_MINUTES=10080
# FLIPCHART_PREVIEW_INTERVAL_SECONDS=90
# FLIPCHART_ROOM_IDLE_MINUTES=10
# FLIPCHART_MAX_UPLOAD_MB=8
